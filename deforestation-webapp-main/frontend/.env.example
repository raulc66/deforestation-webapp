# Copy to .env in this directory and adjust values for your environment.
# Loaded by craco.config.js via dotenv (npm start / npm run build).

# Backend API base URL — no trailing slash
REACT_APP_BACKEND_URL=http://localhost:8000

# Public sales page (optional). Lemon Squeezy checkout URLs go here when issued.
# Leave unset to keep license CTAs as in-page #licenses anchors.
# REACT_APP_PURCHASE_DEVELOPER_URL=
# REACT_APP_PURCHASE_COMMERCIAL_URL=
# REACT_APP_PURCHASE_AGENCY_URL=
# REACT_APP_ACQUISITION_CONTACT_URL=
# REACT_APP_DOCS_URL=

# Optional: enable webpack dev-server health-check plugin
ENABLE_HEALTH_CHECK=false
