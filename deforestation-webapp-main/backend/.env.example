# Copy to .env in this directory and adjust values for your environment.
# Loaded by server.py via python-dotenv.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=forestwatch

# Auth / JWT (use a long random value in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Admin user seeded on startup when missing
ADMIN_EMAIL=admin@forestwatch.io
ADMIN_PASSWORD=ForestAdmin2026!

# Frontend origin (cookies, redirects, CORS context)
FRONTEND_URL=http://localhost:3000

# Allowed browser origins (comma-separated), or * for all
CORS_ORIGINS=http://localhost:3000

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
