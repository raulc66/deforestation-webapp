# Copy to .env in this directory and adjust values for your environment.
# Loaded by server.py via python-dotenv.
#
# DEVELOPMENT DEFAULTS ARE UNSAFE FOR PRODUCTION.
# Set FORESTWATCH_ENV=production on public hosts. Startup will refuse:
# - documented example JWT secrets
# - documented development admin passwords
# - CORS_ORIGINS=* or empty
#
# Also required before public exposure:
# - unique JWT_SECRET (not the example below)
# - unique ADMIN_PASSWORD (never shown on the login page)
# - CORS_ORIGINS = real frontend origin list
# - HTTPS in front of the API (auth cookies are Secure + SameSite=None)
# - Stripe remains disabled unless you enable it with your own Stripe account

FORESTWATCH_ENV=development

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=forestwatch

# Auth / JWT — required. Rotate before any public exposure.
JWT_SECRET=change-me-to-a-long-random-secret

# Admin user seeded on startup when missing (and password is updated from env).
# Development only. Do not use this value in production.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=dev-admin-change-me

# Frontend origin (cookies, redirects, CORS context)
FRONTEND_URL=http://localhost:3000

# Allowed browser origins (comma-separated). Use explicit origins in production.
CORS_ORIGINS=http://localhost:3000

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# NASA FIRMS active fire ingestion (optional)
# Register at https://firms.modaps.eosdis.nasa.gov/api/
# Leave empty to use the bundled mock dataset during development.
FIRMS_API_KEY=

# ---------------------------------------------------------------------------
# Commercial billing (Stripe)
# ---------------------------------------------------------------------------
# Leave ENABLE_BILLING=false for development, tests, and this commercial package.
# Billing surfaces can still render the plan catalog. Checkout is not purchasable
# without Stripe price IDs. No request reaches a real Stripe account while this
# is false. Live Stripe validation is not part of this package.
ENABLE_BILLING=false

# Required once ENABLE_BILLING=true. Use test-mode keys until the funnel has
# been validated end to end.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Pins outbound Stripe API calls to the ForestWatch contract. Must match the
# Dashboard webhook endpoint version. Current pin: 2026-07-29.dahlia.
STRIPE_API_VERSION=2026-07-29.dahlia

# Where Stripe returns the customer after Checkout / Billing Portal.
BILLING_SUCCESS_URL=http://localhost:3000/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled
BILLING_PORTAL_RETURN_URL=http://localhost:3000/billing

# Plan catalog. Prices live in Stripe; ForestWatch only stores the price id and
# the monitoring capacity each plan grants.
STRIPE_PRICE_FOUNDATION=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
PLAN_FOUNDATION_PRICE_LABEL=
PLAN_PROFESSIONAL_PRICE_LABEL=
PLAN_ENTERPRISE_PRICE_LABEL=
PLAN_FOUNDATION_AREA_LIMIT=1
PLAN_PROFESSIONAL_AREA_LIMIT=10
PLAN_ENTERPRISE_AREA_LIMIT=100

# Enterprise is sales-assisted by default (shown, not self-serve purchasable).
PLAN_FOUNDATION_PURCHASABLE=true
PLAN_PROFESSIONAL_PURCHASABLE=true
PLAN_ENTERPRISE_PURCHASABLE=false

# Authenticated free trial (not Stripe). Duration is calendar days from start.
TRIAL_DURATION_DAYS=14
